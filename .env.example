# ============================================================
# NEMO IDE — Variáveis de ambiente
# Copie este arquivo para .env e preencha com seus valores.
#   cp .env.example .env        (Linux / Antigravity)
#   copy .env.example .env      (Windows)
# ============================================================

# --- OpenRouter API -------------------------------------------------------
# Obtenha sua chave em: https://openrouter.ai/keys
# Sem chave (ou chave inválida), o chat roda em modo offline amigável.
OPENROUTER_API_KEY=sua_chave_aqui

# Cabeçalhos opcionais recomendados pelo OpenRouter (identificação/ranking)
OPENROUTER_HTTP_REFERER=http://localhost:8798
OPENROUTER_APP_TITLE=NEMO AI Studio

# --- Servidor -------------------------------------------------------------
# Porta do servidor. Em produção (Render/Railway/etc) a plataforma define
# a variável PORT automaticamente — não é preciso configurar manualmente.
# PORT=8798
# HOST=127.0.0.1

# Origens extras permitidas em CORS, separadas por vírgula.
# Em produção com domínio próprio, use a URL pública do serviço:
# CORS_ORIGINS=https://nemo-ide.onrender.com