# ============================================================
# NEMO IDE — Variáveis de ambiente
# Copie este arquivo para .env e preencha com seus valores.
#   cp .env.example .env        (Linux / Antigravity)
#   copy .env.example .env      (Windows)
# ============================================================

# --- Autenticação ----------------------------------------------------------
# Segredo usado para assinar estados OAuth (CSRF). IMPORTANTE: gere um valor
# aleatório forte em produção, por exemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# OBS: em dev, o servidor já gera um segredo automático por inicialização.
AUTH_SECRET=preencha_com_um_segredo_aleatorio_forte

# --- OpenRouter (cabeçalhos opcionais de identificação/ranking) -------------
# A chave OPENROUTER_API_KEY fica na seção de Provedores de IA abaixo.
OPENROUTER_HTTP_REFERER=http://localhost:8798
OPENROUTER_APP_TITLE=NEMO AI Studio

# --- Login social (Google / Microsoft / Apple) -----------------------------
# Deixe em branco os provedores que não quiser habilitar. Quando todas as
# credenciais de um provedor estiverem preenchidas, o botao aparece na tela
# de login do NEMO. Consulte o README da Missao 6 para criar cada app.
#
# Google — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# Microsoft (Entra) — https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
#
# Apple — https://developer.apple.com/account/resources/authkeys/list
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Conteudo da chave privada .p8 (com \n), ou caminho para o arquivo .p8.
APPLE_PRIVATE_KEY=

# Base publica para os callbacks OAuth (ex.: https://nemo-ide.onrender.com).
# Se ausente, o servidor usa a origem do request (schema://host).
OAUTH_REDIRECT_BASE=

# --- Servidor -------------------------------------------------------------
# Porta do servidor. Em produção (Render/Railway/etc) a plataforma define
# a variável PORT automaticamente — não é preciso configurar manualmente.
# PORT=8798
# HOST=127.0.0.1

# Origens extras permitidas em CORS, separadas por vírgula.
# Em produção com domínio próprio, use a URL pública do serviço:
# CORS_ORIGINS=https://nemo-ide.onrender.com

# --- Provedores de IA (pelo menos UM para o chat responder de verdade) -----
# O NEMO usa uma camada abstrata de IA: Gemini, Groq, OpenAI ou OpenRouter.
# Se nenhum estiver configurado, o chat roda em modo offline amigável.
#
# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
#
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
#
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
#
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=sua_chave_aqui
#
# Provedor padrão do sistema quando o usuário não escolher nenhum.
# Valores: gemini | groq | openai | openrouter
NEMO_AI_PROVIDER=openrouter
#
# Máximo de requisições de IA por minuto por usuário (janela deslizante de 60s).
NEMO_AI_RATE_LIMIT=30

# --- Busca na Internet (Web Search) ---------------------------------------
# Sem chave, o NEMO usa o DuckDuckGo (gratuito). Com Tavily ou Brave,
# a Rebeca Referência ganha resultados estruturados.
# Tavily: https://app.tavily.com
TAVILY_API_KEY=
# Brave: https://api.search.brave.com
BRAVE_API_KEY=
# Limite de buscas por usuário por minuto (anti-abuso — missão §35)
WEB_SEARCH_RATE_LIMIT=10

# --- Supabase (núcleo de dados opcional) ----------------------------------
# Com estas variáveis, conversas, memórias, tarefas e chaves passam a ser
# persistidas no PostgreSQL/Supabase (com RLS). Sem elas, o NEMO usa o
# armazenamento local em _data/ (self-contained).
# Crie o projeto em https://supabase.com e aplique a migration em:
#   supabase/migrations/001_schema_init.sql
#   supabase/migrations/002_auth_tables.sql  (contas + sessões no banco — opcional)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Administração ---------------------------------------------------------
# Bootstrap do primeiro ADMIN (admin único): `python start_nemo.py --create-admin`
# ou `POST /api/auth/bootstrap`, exigindo o e-mail ADMIN_EMAIL fixo no backend.
# 0 desativa o cadastro aberto (só ADMIN cria contas no painel).
NEMO_OPEN_REGISTRATION=1