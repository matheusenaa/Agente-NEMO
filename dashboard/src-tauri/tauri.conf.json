{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SYNOP",
  "version": "1.0.0",
  "identifier": "com.synop.ide",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm.cmd run dev",
    "beforeBuildCommand": "npm.cmd run build"
  },
  "app": {
    "windows": [
      {
        "title": "SYNOP — Inteligência que organiza o seu amanhã",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "focus": true,
        "hiddenTitle": false,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: https:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://*.supabase.co https://openrouter.ai https://api.groq.com https://api.openai.com https://generativelanguage.googleapis.com; font-src 'self' https: data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": null,
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": null
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "fs": {
      "scope": ["$APPDATA/SYNOP/**", "$APPDATA/SYNOP", "$DOWNLOAD/**"]
    },
    "shell": {
      "scope": {
        "allow": ["cmd", "powershell", "python", "npm", "npx"]
      }
    },
    "updater": {
      "endpoints": ["https://releases.synop.app/{{target}}/{{current_version}}"],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbnMgcHViY2tleSBmb3IgdXBkYXRlciBzaG91bGQgYmUgcGxhY2VkIGhlcmU="
    }
  }
}